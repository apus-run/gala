package templates

import "github.com/apus-run/gala/components/fileserver/examples/filehttp/internal/model"

// View 是无 JS 回退列表（/ui/files 路由）的渲染模型。
type View struct {
	Files  []model.FileListItem
	Total  int64
	Flash  string
	Error  string
	UserID uint64
}

// AppConfig 是主页面注入给前端脚本的运行参数。
type AppConfig struct {
	UserID     uint64 `json:"userID"`
	MaxUpload  int64  `json:"maxUpload"`
	MinChunked int64  `json:"minChunked"`
	ChunkSize  int64  `json:"chunkSize"`
}

// AppPage 是文件管理主页面：结构由服务端渲染，交互由 /ui/app.js 驱动，
// 数据全部走 /api JSON 接口。
templ AppPage(cfg AppConfig) {
	@Page("文件管理", appBody(cfg))
}

templ appBody(cfg AppConfig) {
	<header class="appbar">
		<div class="container">
			<div class="brand">
				<div class="logo">📦</div>
				<div>
					<h1>文件管理</h1>
					<p class="sub">SHA-256 内容寻址 · 秒传去重 · 断点续传</p>
				</div>
			</div>
			<label class="userbox">
				当前用户
				<select id="user-select">
					<option value="1">用户 1</option>
					<option value="2">用户 2</option>
					<option value="3">用户 3</option>
				</select>
			</label>
		</div>
	</header>
	<main class="container">
		<div class="layout">
			<aside>
				<section class="card">
					<div class="toolbar">
						<h2>📁 文件夹</h2>
						<button type="button" id="new-folder" class="primary" style="padding:5px 10px; font-size:13px">＋ 新建</button>
					</div>
					<div class="tree" id="tree"></div>
				</section>
			</aside>
			<div>
				<div class="stats">
					<div class="stat">
						<div class="ico" style="background: #eef2ff">🗂️</div>
						<div><div class="num" id="stat-count">—</div><div class="lbl">当前文件夹文件</div></div>
					</div>
					<div class="stat">
						<div class="ico" style="background: #e8f8f1">💾</div>
						<div><div class="num" id="stat-size">—</div><div class="lbl">当前文件夹占用（去重后）</div></div>
					</div>
					<div class="stat">
						<div class="ico" style="background: #fff4e5">⚡</div>
						<div><div class="num" id="stat-transferring">0</div><div class="lbl">传输中</div></div>
					</div>
				</div>

				<section class="card">
					<div class="toolbar">
						<div style="display:flex; gap:14px; align-items:baseline; min-width:0">
							<h2>上传文件</h2>
							<div class="crumb" id="crumb"></div>
						</div>
						<span class="muted" id="limit-hint"></span>
					</div>
					<div class="dropzone" id="dropzone" role="button" tabindex="0">
						<div class="cloud">📤</div>
						<div class="big">点击选择或拖拽 文件 / 图片 / 视频 到此处上传</div>
						<div class="small" id="dropzone-sub">支持多文件 · 大于 10 MB 自动分块断点续传 · 相同内容秒传</div>
					</div>
					<input type="file" id="file-input" multiple hidden/>
					<input type="file" id="replace-input" hidden/>
				</section>

				<section class="card" id="queue-card" hidden>
					<div class="toolbar">
						<h2>传输队列</h2>
						<button class="ghost" id="queue-clear" type="button">清除已完成</button>
					</div>
					<div id="queue"></div>
				</section>

				<section class="card">
					<div class="toolbar">
						<div class="tabs" id="tabs">
							<button type="button" data-tab="mine" class="active">我的文件</button>
							<button type="button" data-tab="public">公开文件</button>
						</div>
						<div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap">
							<div class="chips" id="chips">
								<button type="button" data-type="all" class="active">全部</button>
								<button type="button" data-type="image">图片</button>
								<button type="button" data-type="video">视频</button>
								<button type="button" data-type="doc">文档</button>
								<button type="button" data-type="other">其他</button>
							</div>
							<input type="search" id="search" placeholder="搜索文件名…"/>
							<button type="button" id="refresh">刷新</button>
						</div>
					</div>
					<table>
						<thead>
							<tr>
								<th>文件名</th>
								<th>大小</th>
								<th>上传时间</th>
								<th>SHA-256</th>
								<th id="th-owner">操作</th>
							</tr>
						</thead>
						<tbody id="rows"></tbody>
					</table>
					<div class="empty" id="empty" hidden>
						<div class="big">🗂️</div>
						当前文件夹还没有文件，拖一个上来试试
					</div>
				</section>
			</div>
		</div>
	</main>

	<div id="toasts" aria-live="polite"></div>

	<div class="modal-back" id="rename-back">
		<div class="modal">
			<h3>重命名</h3>
			<p id="rename-hash"></p>
			<input type="text" id="rename-input" maxlength="255"/>
			<div class="foot">
				<button type="button" id="rename-cancel">取消</button>
				<button type="button" class="primary" id="rename-save">保存</button>
			</div>
		</div>
	</div>

	<div class="modal-back" id="delete-back">
		<div class="modal">
			<h3>删除文件</h3>
			<p id="delete-name"></p>
			<p>删除你的引用；当没有人再引用这份内容时，物理对象也会被删除。</p>
			<div class="foot">
				<button type="button" id="delete-cancel">取消</button>
				<button type="button" class="danger" id="delete-save">删除</button>
			</div>
		</div>
	</div>

	<div class="modal-back" id="folder-new-back">
		<div class="modal">
			<h3 id="folder-new-title">新建文件夹</h3>
			<p id="folder-new-parent"></p>
			<input type="text" id="folder-new-input" maxlength="255" placeholder="文件夹名称（可用 / 分层）"/>
			<div class="foot">
				<button type="button" id="folder-new-cancel">取消</button>
				<button type="button" class="primary" id="folder-new-save">创建</button>
			</div>
		</div>
	</div>

	<div class="modal-back" id="folder-del-back">
		<div class="modal">
			<h3>删除文件夹</h3>
			<p id="folder-del-path"></p>
			<p>只能删除空文件夹；里面有文件或子文件夹时会拒绝。</p>
			<div class="foot">
				<button type="button" id="folder-del-cancel">取消</button>
				<button type="button" class="danger" id="folder-del-save">删除</button>
			</div>
		</div>
	</div>

	@templ.JSONScript("app-cfg", cfg)
	<script src="/ui/app.js" defer></script>
}

// FilesPage 是无 JS 环境的回退页。
templ FilesPage(v View) {
	@Page("文件管理", legacyBody(v))
}

templ legacyBody(v View) {
	<main class="container" style="margin-top: 24px">
		<section class="card">
			<h2>我的文件 <span class="muted">({ v.Total })</span></h2>
			if v.Flash != "" {
				<div class="toast ok" style="position:static; margin-top: 10px">{ v.Flash }</div>
			}
			if v.Error != "" {
				<div class="toast err" style="position:static; margin-top: 10px">{ v.Error }</div>
			}
			@FileList(v)
		</section>
	</main>
}

templ FileList(v View) {
	<div id="file-list">
		if v.Flash != "" {
			<div class="toast ok" style="position:static; margin: 10px 0 0" role="status">{ v.Flash }</div>
		}
		if v.Error != "" {
			<div class="toast err" style="position:static; margin: 10px 0 0" role="alert">{ v.Error }</div>
		}
		if len(v.Files) == 0 {
			<p class="empty">还没有文件，选择一个文件开始上传。</p>
		} else {
			<table>
				<thead>
					<tr>
						<th>文件名</th>
						<th>大小</th>
						<th>上传时间</th>
					</tr>
				</thead>
				<tbody>
					for _, f := range v.Files {
						<tr>
							<td>
								<a href={ templ.URL("/api/files/" + f.FileHash) } target="_blank" rel="noreferrer">{ f.FileName }</a>
							</td>
							<td>{ humanSize(f.FileSize) }</td>
							<td class="muted">{ f.CreatedAt.Format("2006-01-02 15:04") }</td>
						</tr>
					}
				</tbody>
			</table>
		}
	</div>
}
